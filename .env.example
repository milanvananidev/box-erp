# Frontend data source: "mock" (default, UI review) or "tauri" (real Rust commands)
VITE_DATA_SOURCE=mock

# Development only (debug builds). Release builds ignore these and read the
# connection from the OS keychain, set via Settings → Database connection.
# BOXERP_MONGODB_URI=mongodb+srv://<dev-user>:<password>@<cluster>/
# BOXERP_MONGODB_DB=boxerp_dev
